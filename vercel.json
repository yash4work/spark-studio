{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:lang(de|es|fr)/blog/:slug(best-luxury-real-estate-framer-templates-for-brokers|top-10-framer-templates-for-architects-and-design-studios-2026|onyx-atelier-framer-architecture-template-review|slowgrain-solum-framer-architecture-template-free-review|sasso-architect-framer-template-review|aurelle-estates-framer-architecture-template-review|vellum-edition-framer-architecture-template-review|how-we-achieve-90-plus-pagespeed-on-framer-sites|top-framer-templates-for-real-estate-and-architecture-2026|figma-to-framer-agency-migration-guide)",
      "destination": "/blog/:slug",
      "permanent": true
    },
    {
      "source": "/:slug(ai-saas|luxury-restaurant|premium-healthcare|mavric-estate|aurelle-estates|onyx-atelier|vellum-edition|halden-edition|grain-form|slowgrain|terra|sasso-architect|tessovra|onyx-atelier-pro|lume-field|solum-edition|hearthflow)",
      "destination": "/templates/:slug",
      "permanent": true
    },
    {
      "source": "/:lang(de|es|fr)/:slug(ai-saas|luxury-restaurant|premium-healthcare|mavric-estate|aurelle-estates|onyx-atelier|vellum-edition|halden-edition|grain-form|slowgrain|terra|sasso-architect|tessovra|onyx-atelier-pro|lume-field|solum-edition|hearthflow)",
      "destination": "/:lang/templates/:slug",
      "permanent": true
    }
  ]
}
